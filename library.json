{
  "name": "EDP-Platform-ESP-IDF",
  "description": "ESP-IDF-specific concrete providers for EDP-Platform, EDP-Memory and EDP-Security",
  "keywords": "espressio,platform,esp-idf,espressif,execution,affinity,spinlock,memory,psram,security,aes,gcm,embedded",
  "homepage": "https://espressio.org",
  "authors": {
    "name": "Simon J. Stuart",
    "maintainer": true,
    "url": "https://espressio.org"
  },
  "build": {
    "flags": [
      "-std=gnu++20"
    ],
    "unflags": [
      "-std=gnu++11",
      "-std=gnu++14",
      "-std=gnu++17"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ESPressio-Development-Platform/EDP-Platform-ESP-IDF.git"
  },
  "version": "0.1.0",
  "license": "Apache-2.0",
  "frameworks": "espidf",
  "platforms": "espressif32",
  "dependencies": [
    {
      "name": "EDP-Platform",
      "version": "https://github.com/ESPressio-Development-Platform/EDP-Platform.git#main"
    },
    {
      "name": "EDP-Memory",
      "version": "https://github.com/ESPressio-Development-Platform/EDP-Memory.git#main"
    },
    {
      "name": "EDP-Security",
      "version": "https://github.com/ESPressio-Development-Platform/EDP-Security.git#main"
    }
  ]
}
